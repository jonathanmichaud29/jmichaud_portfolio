---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
  series: CollectionEntry<"series">;
}

const { post, series } = Astro.props;

const allPosts = await getCollection("blog", ({ data }) => !data.noindex);
const seriesPosts = allPosts
  .filter((p) => p.data.series?.id === series.id)
  .sort((a, b) => (a.data.seriesPart ?? 0) - (b.data.seriesPart ?? 0));

const currentIndex = seriesPosts.findIndex((p) => p.id === post.id);
const nextPost =
  currentIndex >= 0 && currentIndex < seriesPosts.length - 1
    ? seriesPosts[currentIndex + 1]
    : null;
---

{
  nextPost && (
    <nav
      class="mt-10 pt-8 border-t border-bg-border"
      aria-label="Next article in series"
    >
      <p class="font-mono text-xs uppercase tracking-widest text-text-muted mb-3">
        Next in series
      </p>
      <a
        href={`/blog/${nextPost.id}`}
        class="group flex items-center justify-between gap-4 rounded-lg border border-bg-border bg-bg-surface px-5 py-4 hover:border-accent transition-colors duration-150"
      >
        <div class="min-w-0">
          <p class="font-mono text-xs text-text-muted mb-1">
            Part {nextPost.data.seriesPart}
          </p>
          <p class="text-base font-medium text-text-primary group-hover:text-accent transition-colors duration-150 truncate">
            {nextPost.data.title}
          </p>
          {nextPost.data.description && (
            <p class="text-sm text-text-muted mt-1 line-clamp-2">
              {nextPost.data.description}
            </p>
          )}
        </div>
        <span
          class="text-text-muted group-hover:text-accent transition-colors duration-150 flex-shrink-0 text-lg leading-none"
          aria-hidden="true"
        >
          →
        </span>
      </a>
    </nav>
  )
}
